<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:ProgramNumericalMet.ViewModels"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:local="using:ProgramNumericalMet"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="ProgramNumericalMet.Views.FourierSeriesView"
			 x:DataType="vm:FourierSeriesViewModel">
	<Grid ColumnDefinitions="300,*" RowDefinitions="50, *">
		<StackPanel HorizontalAlignment="Center" Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal">
			<RadioButton Content="Ряд Тейлора" Padding="10"  Command="{Binding InFunctionSeries}" IsEnabled="True"/>
			<RadioButton Content="Ряд Фурье" Padding="10" IsChecked="true" IsEnabled="True"/>
		</StackPanel>
	</Grid>
</UserControl>

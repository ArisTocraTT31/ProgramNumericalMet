<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:ProgramNumericalMet.ViewModels"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="ProgramNumericalMet.Views.Markup"
			 x:DataType="vm:MainWindowViewModel">

	<Grid RowDefinitions="20,50,*" ColumnDefinitions="350,*">
		<Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Background="#96f8f0" />
		<Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Background="#96f8f0" />
		<StackPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" >
			<StackPanel Orientation="Horizontal"  >
				<TextBlock Text="Выбор задания:" Padding="10" FontSize="24" Foreground="#005c55" FontWeight="Bold"/>
				<Button Content="Назад" Command="{Binding MainScreenVM.ExitChoice}" Background="#FF9340" Foreground="#FFF" FontWeight="Bold"/>
			</StackPanel>
			<ListBox
			ItemsSource="{Binding MainScreenVM.ListZadania}"
			SelectedItem="{Binding MainScreenVM.SelectedChoice}"
			Background="Transparent">
				<ListBox.Styles>
					<Style Selector="ListBoxItem:selected">
						<Setter Property="Background" Value="#1E828A"/>
						<Setter Property="Foreground" Value="#005c55"/>
					</Style>
					<Style Selector="ListBoxItem:selected /template/ ContentPresenter">
						<Setter Property="Background" Value="#17686E" />
						<Setter Property="TextBlock.Foreground" Value="#FFF" />
					</Style>
					<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
						<Setter Property="Background" Value="#5CD1DB" />
						<Setter Property="TextBlock.Foreground" Value="#005c55" />
					</Style>
				</ListBox.Styles>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding Title}"
								   TextWrapping="Wrap" Padding="10" FontWeight="Bold" FontSize="16"/>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</StackPanel>
		<ContentControl Content="{Binding Page}" Grid.Row="2" Grid.Column="1"/>
	</Grid>
</UserControl>
